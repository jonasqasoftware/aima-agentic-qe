{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIMA change input",
  "type": "object",
  "required": ["id", "summary", "changedFiles", "businessImpact", "technicalComplexity"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "changedFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "businessImpact": { "enum": ["low", "medium", "high"] },
    "technicalComplexity": { "enum": ["low", "medium", "high"] },
    "knownUnknowns": { "type": "array", "items": { "type": "string" } },
    "declaredEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
